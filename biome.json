{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": ["src/**", "*.html", "*.json", "!package-lock.json"]
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noAssignInExpressions": "warn",
        "noDuplicateProperties": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noSelfCompare": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
